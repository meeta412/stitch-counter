# Backend
DATABASE_URL=sqlite:///./stitch_counter.db

# Supabase (required for cloud sync)
# Use your real project URL — same value as VITE_SUPABASE_URL in frontend/.env
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Frontend (copy to frontend/.env)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_URL=/api

# AI pattern parsing
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
# Set to false on corporate VPN if SSL errors occur (local dev only)
SSL_VERIFY=true

# CORS
CORS_ORIGINS=http://localhost:5173
